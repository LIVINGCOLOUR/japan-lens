// Cloudflare Workers の静的アセットとして out/ を配信し、/api/* だけを Worker（worker/index.ts）で処理する。
// ビルド: npm run build → デプロイ: npx wrangler deploy
// 「AIで本文を読む」は予約を受け付けるだけで、AI は呼ばない（読むのは毎朝の収集。collector/reader.py）
{
  "name": "japan-lens",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 「AIで本文を読む」の予約を記録する
  "kv_namespaces": [{ "binding": "READS", "id": "d8899d588c604d9d8d2032a4a5b13ecb" }],
  // 予約は1つの IP から1分に10件まで
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}
